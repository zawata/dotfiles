{
  "clangd.detectExtensionConflicts": false,
  "editor.fontLigatures": true,
  "editor.guides.bracketPairs": true,
  "editor.inlayHints.enabled": "off",
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": false,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [120],
  "editor.fontSize": 12,
  "editor.unicodeHighlight.allowedCharacters": { "️": true },
  "emmet.showAbbreviationSuggestions": false,
  "eslint.alwaysShowStatus": true,
  "eslint.format.enable": true,
  "eslint.onIgnoredFiles": "warn",
  "eslint.probe": ["javascript", "javascriptreact", "html", "vue", "markdown"],
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "onFocusChange",
  "git.ignoreLegacyWarning": true,
  "git.mergeEditor": false,
  "gitkraken.env": "staging",
  "gitlens.hovers.currentLine.over": "line",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.validate.enable": false,
  "security.workspace.trust.untrustedFiles": "open",
  "telemetry.telemetryLevel": "crash",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "window.autoDetectColorScheme": true,
  "window.dialogStyle": "custom",
  "window.menuBarVisibility": "visible",
  "workbench.enableExperiments": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "editor.fontFamily": "'FiraCode NF'",
  "terminal.explorerKind": "external",
  "terminal.external.linuxExec": "konsole",
  "debug.terminal.clearBeforeReusing": true,
  "terminal.integrated.defaultLocation": "editor",
  "workbench.colorCustomizations": {
    // "[Tokyo Night]": {
    //   "activityBar.foreground": "#bdc7f0",
    //   "activityBar.inactiveForeground": "#787c99",
    //   "breadcrumb.activeSelectionForeground": "#bdc7f0",
